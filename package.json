{
  "name": "qa-automation-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Demonstration Playwright UI and API test suite for OWASP Juice Shop",
  "scripts": {
    "app:start": "docker compose up -d",
    "app:stop": "docker compose down --volumes",
    "test": "playwright test",
    "test:ui": "playwright test --project=ui",
    "test:api": "playwright test --project=api",
    "test:bdd": "docker compose up -d && wait-on http://127.0.0.1:3000 && cucumber-js",
    "test:all": "npm test && npm run test:bdd",
    "test:headed": "playwright test --project=ui --headed",
    "test:types": "tsc --noEmit",
    "report": "playwright show-report"
  },
  "engines": {
    "node": "22 || 24"
  },
  "devDependencies": {
    "@cucumber/cucumber": "13.3.0",
    "@playwright/test": "1.56.1",
    "@types/node": "24.10.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "wait-on": "9.5.1"
  }
}
